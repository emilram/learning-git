.cs-root .cs-street{fill:none;stroke-linecap:round;stroke-linejoin:round}
.cs-root .cs-casing.cs-avenue{stroke:var(--cs-street-avenue-casing)}
.cs-root .cs-casing.cs-street{stroke:var(--cs-street-street-casing)}
.cs-root .cs-casing.cs-alley{stroke:var(--cs-street-alley-casing)}
.cs-root .cs-fill.cs-avenue{stroke:var(--cs-street-avenue-stroke)}
.cs-root .cs-fill.cs-street{stroke:var(--cs-street-street-stroke)}
.cs-root .cs-fill.cs-alley{stroke:var(--cs-street-alley-stroke)}
.cs-root .cs-label{fill:var(--cs-label-fill);font-family:var(--cs-label-font);letter-spacing:var(--cs-label-spacing);paint-order:stroke;stroke:var(--cs-label-halo);stroke-width:2.5;stroke-linejoin:round;text-anchor:middle;dominant-baseline:middle}
.cs-root .cs-label-path{fill:none;stroke:none}
.cs-root .cs-poi{fill:var(--cs-poi-fill);stroke:var(--cs-poi-stroke);stroke-width:1.2}
.cs-root .cs-poi-ring{fill:none;stroke:var(--cs-poi-ring);stroke-width:1.5}
.cs-root .cs-water{fill:var(--cs-block-water-fill);stroke:var(--cs-block-water-stroke);stroke-width:0.8}
@media (forced-colors: active){.cs-root .cs-block{fill:Canvas;stroke:CanvasText}.cs-root .cs-street{stroke:CanvasText}.cs-root .cs-label{fill:CanvasText;stroke:Canvas}.cs-root .cs-poi{fill:Highlight;stroke:Canvas}.cs-root .cs-pattern{display:none}}</style>
