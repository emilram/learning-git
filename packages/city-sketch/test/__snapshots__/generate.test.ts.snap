exports[`serializeSvg > snapshot minimal-mono 1`] = `
"<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 400 300" width="400" height="300" class="cs-root" data-seed="snap" data-theme="minimal-mono" style="--cs-canvas-bg:oklch(100% 0 0);--cs-canvas-grid:oklch(85% 0 0);--cs-ink:oklch(15% 0 0);--cs-ink-muted:oklch(50% 0 0);--cs-surface:oklch(100% 0 0);--cs-accent:oklch(50% 0 0);--cs-accent-alt:oklch(15% 0 0);--cs-danger:oklch(58% 0.2 25);--cs-success:oklch(62% 0.13 150);--cs-street-avenue-stroke:oklch(15% 0 0);--cs-street-avenue-casing:oklch(100% 0 0);--cs-street-avenue-scale:0.35;--cs-street-avenue-dash:none;--cs-street-street-stroke:oklch(15% 0 0);--cs-street-street-casing:oklch(100% 0 0);--cs-street-street-scale:0.2;--cs-street-street-dash:none;--cs-street-alley-stroke:oklch(50% 0 0);--cs-street-alley-casing:oklch(100% 0 0);--cs-street-alley-scale:0.18;--cs-street-alley-dash:2 2;--cs-block-retail-fill:oklch(97% 0 0);--cs-block-retail-stroke:oklch(85% 0 0);--cs-block-retail-opacity:1;--cs-block-residential-fill:oklch(96% 0 0);--cs-block-residential-stroke:oklch(85% 0 0);--cs-block-residential-opacity:1;--cs-block-park-fill:oklch(94% 0 0);--cs-block-park-stroke:oklch(85% 0 0);--cs-block-park-opacity:1;--cs-block-water-fill:oklch(92% 0 0);--cs-block-water-stroke:oklch(85% 0 0);--cs-block-water-opacity:1;--cs-block-plaza-fill:oklch(97% 0 0);--cs-block-plaza-stroke:oklch(85% 0 0);--cs-block-plaza-opacity:1;--cs-lot-stroke:oklch(85% 0 0);--cs-lot-width:0.3;--cs-lot-opacity:0.6;--cs-label-fill:oklch(15% 0 0);--cs-label-halo:oklch(100% 0 0);--cs-label-font:&quot;Inter&quot;, &quot;Segoe UI&quot;, system-ui, sans-serif;--cs-label-spacing:0.04em;--cs-poi-fill:oklch(15% 0 0);--cs-poi-stroke:oklch(100% 0 0);--cs-poi-ring:oklch(50% 0 0);--cs-poi-size:6;--cs-font-display:&quot;Inter&quot;, &quot;Segoe UI&quot;, system-ui, sans-serif;--cs-font-body:&quot;Inter&quot;, &quot;Segoe UI&quot;, system-ui, sans-serif" role="img" aria-labelledby="cs-title cs-desc">
<title id="cs-title">Croquis de ciudad snap</title><desc id="cs-desc">Ciudad sintetica con 14 calles, 9 manzanas y 6 puntos de interes. Modo organic-voronoi.</desc>
<style>.cs-root{font-family:var(--cs-font-body);color-scheme:light dark}
.cs-root .cs-canvas{fill:var(--cs-canvas-bg)}
.cs-root .cs-block{stroke-width:0.6;stroke-linejoin:round}
.cs-root .cs-lu-retail{fill:var(--cs-block-retail-fill);stroke:var(--cs-block-retail-stroke);opacity:var(--cs-block-retail-opacity)}
.cs-root .cs-lu-residential{fill:var(--cs-block-residential-fill);stroke:var(--cs-block-residential-stroke);opacity:var(--cs-block-residential-opacity)}
.cs-root .cs-lu-park{fill:var(--cs-block-park-fill);stroke:var(--cs-block-park-stroke);opacity:var(--cs-block-park-opacity)}
.cs-root .cs-lu-water{fill:var(--cs-block-water-fill);stroke:var(--cs-block-water-stroke);opacity:var(--cs-block-water-opacity)}
.cs-root .cs-lu-plaza{fill:var(--cs-block-plaza-fill);stroke:var(--cs-block-plaza-stroke);opacity:var(--cs-block-plaza-opacity)}
.cs-root .cs-pattern{fill-opacity:0.55}
.cs-root .cs-lot{fill:none;stroke:var(--cs-lot-stroke);stroke-width:var(--cs-lot-width);opacity:var(--cs-lot-opacity)}
.cs-root .cs-street{fill:none;stroke-linecap:round;stroke-linejoin:round}
.cs-root .cs-casing.cs-avenue{stroke:var(--cs-street-avenue-casing)}
.cs-root .cs-casing.cs-street{stroke:var(--cs-street-street-casing)}
.cs-root .cs-casing.cs-alley{stroke:var(--cs-street-alley-casing)}
.cs-root .cs-fill.cs-avenue{stroke:var(--cs-street-avenue-stroke)}
.cs-root .cs-fill.cs-street{stroke:var(--cs-street-street-stroke)}
.cs-root .cs-fill.cs-alley{stroke:var(--cs-street-alley-stroke)}
.cs-root .cs-label{fill:var(--cs-label-fill);font-family:var(--cs-label-font);letter-spacing:var(--cs-label-spacing);paint-order:stroke;stroke:var(--cs-label-halo);stroke-width:2.5;stroke-linejoin:round;text-anchor:middle;dominant-baseline:middle}
.cs-root .cs-label-path{fill:none;stroke:none}
.cs-root .cs-poi{fill:var(--cs-poi-fill);stroke:var(--cs-poi-stroke);stroke-width:1.2}
.cs-root .cs-poi-ring{fill:none;stroke:var(--cs-poi-ring);stroke-width:1.5}
.cs-root .cs-water{fill:var(--cs-block-water-fill);stroke:var(--cs-block-water-stroke);stroke-width:0.8}
@media (forced-colors: active){.cs-root .cs-block{fill:Canvas;stroke:CanvasText}.cs-root .cs-street{stroke:CanvasText}.cs-root .cs-label{fill:CanvasText;stroke:Canvas}.cs-root .cs-poi{fill:Highlight;stroke:Canvas}.cs-root .cs-pattern{display:none}}</style>
<defs><pattern id="cs-hatch" patternUnits="userSpaceOnUse" width="6" height="6" patternTransform="rotate(45)"><line x1="0" y1="0" x2="0" y2="6" stroke="currentColor" stroke-width="0.6"/></pattern><pattern id="cs-cross-hatch" patternUnits="userSpaceOnUse" width="6" height="6"><path d="M0 3H6M3 0V6" stroke="currentColor" stroke-width="0.5"/></pattern><pattern id="cs-dots" patternUnits="userSpaceOnUse" width="5" height="5"><circle cx="2.5" cy="2.5" r="0.7" fill="currentColor"/></pattern><pattern id="cs-grid" patternUnits="userSpaceOnUse" width="8" height="8"><path d="M8 0H0V8" fill="none" stroke="currentColor" stroke-width="0.4"/></pattern><symbol id="cs-poi" viewBox="-10 -10 20 20" overflow="visible"><circle class="cs-poi-ring" r="7.5" style="fill:none;stroke:var(--cs-poi-ring);stroke-width:1.5"/><circle class="cs-poi" r="4.5" style="fill:var(--cs-poi-fill);stroke:var(--cs-poi-stroke);stroke-width:1.2"/></symbol></defs>
