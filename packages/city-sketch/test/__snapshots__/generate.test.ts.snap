@media (forced-colors: active){.cs-root .cs-block{fill:Canvas;stroke:CanvasText}.cs-root .cs-street{stroke:CanvasText}.cs-root .cs-label{fill:CanvasText;stroke:Canvas}.cs-root .cs-poi{fill:Highlight;stroke:Canvas}.cs-root .cs-pattern{display:none}}
.cs-iso .cs-wall{stroke:var(--cs-ink-muted);stroke-width:0.35;stroke-linejoin:round}.cs-iso .cs-roof{stroke:var(--cs-ink-muted);stroke-width:0.4;stroke-linejoin:round}.cs-iso .cs-shadow{fill:var(--cs-ink);opacity:0.12}.cs-iso .cs-pin{stroke:var(--cs-ink);stroke-width:1}.cs-iso .cs-pin-head{fill:var(--cs-poi-fill);stroke:var(--cs-poi-stroke);stroke-width:1.2}.cs-iso .cs-pin-ring{fill:none;stroke:var(--cs-poi-ring);stroke-width:1.5}.cs-iso .cs-pin-label{font-family:var(--cs-label-font);font-size:9px;font-weight:600;fill:var(--cs-ink);paint-order:stroke;stroke:var(--cs-surface);stroke-width:3;stroke-linejoin:round;text-anchor:middle}</style>
