exports[`serializeSvg > snapshot blueprint 1`] = `
"<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 400 300" width="400" height="300" class="cs-root" data-seed="snap" data-theme="blueprint" style="--cs-canvas-bg:oklch(36% 0.11 255);--cs-canvas-grid:oklch(55% 0.08 255);--cs-ink:oklch(97% 0.02 250);--cs-ink-muted:oklch(85% 0.05 250);--cs-surface:oklch(36% 0.11 255);--cs-accent:oklch(92% 0.06 220);--cs-accent-alt:oklch(85% 0.15 80);--cs-danger:oklch(58% 0.2 25);--cs-success:oklch(62% 0.13 150);--cs-street-avenue-stroke:oklch(97% 0.02 250);--cs-street-avenue-casing:oklch(36% 0.11 255);--cs-street-avenue-scale:0.55;--cs-street-avenue-dash:none;--cs-street-street-stroke:oklch(85% 0.05 250);--cs-street-street-casing:oklch(36% 0.11 255);--cs-street-street-scale:0.45;--cs-street-street-dash:none;--cs-street-alley-stroke:oklch(85% 0.05 250);--cs-street-alley-casing:oklch(36% 0.11 255);--cs-street-alley-scale:0.4;--cs-street-alley-dash:3 2;--cs-block-retail-fill:oklch(44% 0.1 255);--cs-block-retail-stroke:oklch(85% 0.05 250);--cs-block-retail-opacity:1;--cs-block-residential-fill:oklch(40% 0.1 255);--cs-block-residential-stroke:oklch(85% 0.05 250);--cs-block-residential-opacity:1;--cs-block-park-fill:oklch(45% 0.09 200);--cs-block-park-stroke:oklch(85% 0.05 250);--cs-block-park-opacity:1;--cs-block-water-fill:oklch(30% 0.09 255);--cs-block-water-stroke:oklch(85% 0.05 250);--cs-block-water-opacity:1;--cs-block-plaza-fill:oklch(44% 0.1 255);--cs-block-plaza-stroke:oklch(85% 0.05 250);--cs-block-plaza-opacity:1;--cs-lot-stroke:oklch(85% 0.05 250);--cs-lot-width:0.35;--cs-lot-opacity:0.45;--cs-label-fill:oklch(97% 0.02 250);--cs-label-halo:oklch(36% 0.11 255);--cs-label-font:&quot;Inter&quot;, &quot;Segoe UI&quot;, system-ui, sans-serif;--cs-label-spacing:0.04em;--cs-poi-fill:oklch(85% 0.15 80);--cs-poi-stroke:oklch(36% 0.11 255);--cs-poi-ring:oklch(92% 0.06 220);--cs-poi-size:7;--cs-font-display:&quot;Inter&quot;, &quot;Segoe UI&quot;, system-ui, sans-serif;--cs-font-body:&quot;Inter&quot;, &quot;Segoe UI&quot;, system-ui, sans-serif" role="img" aria-labelledby="cs-title cs-desc">
<title id="cs-title">Croquis de ciudad snap</title><desc id="cs-desc">Ciudad sintetica con 15 calles, 6 manzanas y 6 puntos de interes. Modo organic-voronoi.</desc>
<style>.cs-root{font-family:var(--cs-font-body);color-scheme:light dark}
.cs-root .cs-canvas{fill:var(--cs-canvas-bg)}
.cs-root .cs-block{stroke-width:0.6;stroke-linejoin:round}
.cs-root .cs-lu-retail{fill:var(--cs-block-retail-fill);stroke:var(--cs-block-retail-stroke);opacity:var(--cs-block-retail-opacity)}
.cs-root .cs-lu-residential{fill:var(--cs-block-residential-fill);stroke:var(--cs-block-residential-stroke);opacity:var(--cs-block-residential-opacity)}
.cs-root .cs-lu-park{fill:var(--cs-block-park-fill);stroke:var(--cs-block-park-stroke);opacity:var(--cs-block-park-opacity)}
.cs-root .cs-lu-water{fill:var(--cs-block-water-fill);stroke:var(--cs-block-water-stroke);opacity:var(--cs-block-water-opacity)}
.cs-root .cs-lu-plaza{fill:var(--cs-block-plaza-fill);stroke:var(--cs-block-plaza-stroke);opacity:var(--cs-block-plaza-opacity)}
.cs-root .cs-pattern{fill-opacity:0.55}
.cs-root .cs-lot{fill:none;stroke:var(--cs-lot-stroke);stroke-width:var(--cs-lot-width);opacity:var(--cs-lot-opacity)}
.cs-root .cs-street{fill:none;stroke-linecap:round;stroke-linejoin:round}
.cs-root .cs-casing.cs-avenue{stroke:var(--cs-street-avenue-casing)}
.cs-root .cs-casing.cs-street{stroke:var(--cs-street-street-casing)}
.cs-root .cs-casing.cs-alley{stroke:var(--cs-street-alley-casing)}
.cs-root .cs-fill.cs-avenue{stroke:var(--cs-street-avenue-stroke)}
.cs-root .cs-fill.cs-street{stroke:var(--cs-street-street-stroke)}
.cs-root .cs-fill.cs-alley{stroke:var(--cs-street-alley-stroke)}
.cs-root .cs-label{fill:var(--cs-label-fill);font-family:var(--cs-label-font);letter-spacing:var(--cs-label-spacing);paint-order:stroke;stroke:var(--cs-label-halo);stroke-width:2.5;stroke-linejoin:round;text-anchor:middle;dominant-baseline:middle}
.cs-root .cs-label-path{fill:none;stroke:none}
